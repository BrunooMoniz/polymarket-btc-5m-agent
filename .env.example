# Copie para .env e preencha. NUNCA comite o .env.
# ---- obrigatórias
TYPESAFE_API_KEY=
EXECUTION_MODE=paper            # paper | live  (live manda ordem de verdade)
DATA_DIR=data

# ---- live (só com EXECUTION_MODE=live)
POLYMARKET_PRIVATE_KEY=         # chave da carteira que assina as ordens
POLYMARKET_PROXY_WALLET=        # carteira proxy da Polymarket (signature_type=3)
POLYGON_CHAIN_ID=137
CLOB_SOCKS_PROXY=               # rota de saída do CLOB (socks5://host:porta), se houver
CLOB_EGRESS_FALLBACKS=          # rotas reservas separadas por vírgula
CLOB_ALLOW_DIRECT=              # 1 aceita sair sem proxy no modo live

# ---- risco e execução
PAPER_BANKROLL_USD=25
MAX_STAKE_USD=5
MIN_NET_EDGE=0.04
DAILY_LOSS_LIMIT_USD=10
ORDER_TTL_S=12
MAX_REQUOTES=3
MAX_CROSS_RETRIES=3
REQUOTE_RECHECK_S=1.5
MAX_JEV_CALLS_PER_WINDOW=2

# ---- alertas (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_TRADES=1

# ---- hipóteses sob bandeira (desligadas; prove no shadow antes de ligar no live)
JEV_GATE=1                      # veto do Jev por direção/anomalia
JEV_REGIME_ADJUST=1             # multiplicador de σ pelo regime (com os dois em 0 não chama o Jev)
JEV_QUESTION_SET=direction      # direction | meta (meta pergunta se a estimativa do modelo é confiável)
JEV_MIN_RELIABILITY=0
ALLOW_TAKER=0
TAKER_MIN_EDGE=0.10
EARLY_EXIT_P=0
SIZING_MODE=fixed               # fixed | conviction | jev (jev exige JEV_QUESTION_SET=meta)
MIN_STAKE_USD=1
FAVORED_SIDE_ONLY=1
SIGMA_PRIOR_AUTO=0

# ---- shadows em paper ao lado do motor
SHADOW_PROFILES=                # ex.: control,tail,taker
# SHADOW_TAIL_FAVORED_SIDE_ONLY=0
# SHADOW_TAKER_ALLOW_TAKER=1
